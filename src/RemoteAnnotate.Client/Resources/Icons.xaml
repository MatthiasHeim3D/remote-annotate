<!--
  Fluent UI System Icons (Regular, 20px) as vector geometry, so there is no icon font or
  package dependency and icons stay sharp at any DPI and take the surrounding Foreground.
  Source: https://github.com/microsoft/fluentui-system-icons
  Copyright (c) 2020 Microsoft Corporation, MIT License (see THIRD-PARTY-NOTICES.md at the repository root).

  Every icon here is drawn on a 20 x 20 grid. Show one with the FluentIcon style:
    <ContentControl Style="{StaticResource FluentIcon}" Content="{StaticResource Icon.Dismiss}" />
  Its size follows FontSize, which is inherited, so it can replace a font glyph in place.
  The GitHub mark is not part of Fluent; it is the one brand mark kept here so every icon
  has a single home.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="FluentIcon" TargetType="ContentControl">
        <Setter Property="Width" Value="{Binding FontSize, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Height" Value="{Binding FontSize, RelativeSource={RelativeSource Self}}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="20" Height="20">
                            <Path Data="{TemplateBinding Content}"
                                  Fill="{TemplateBinding Foreground}" />
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
